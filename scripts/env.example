# Copy to scripts/.env and edit as needed

# Server IP for display notes (students use this in QGC)
SERVER_IP=10.30.0.3

# Number of teams / lanes
NUM_VEHICLES=6

# Student-facing TCP base and step
GCS_TCP_BASE=15000
GCS_TCP_STEP=10

# SITL UDP base (ArduPilot default is 14550 for instance 0, 14560 for instance 1, etc.)
SITL_UDP_BASE=14550

# Path to ArduPilot tree
ARDUPILOT_HOME="$HOME/ardupilot"

# Virtualenv for CLI tools (optional, but recommended)
VENV_PATH="$HOME/ardupilot/venv/bin/activate"

# Web app token (for reset site)
SITLWEB_TOKEN=change-me

# Web app port
SITLWEB_PORT=8080
